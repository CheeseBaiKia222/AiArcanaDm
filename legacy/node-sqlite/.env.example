# Node 24+ is the only runtime dependency. No hosted-service credentials required.
PORT=4317
HOST=127.0.0.1
# For a deployed instance, set the exact public HTTPS origin and SECURE_COOKIES=true.
# APP_ORIGIN=https://mosaic.example.com
SECURE_COOKIES=false
# Defaults to ./data/mosaic.db. Keep this persistent and private on your server.
# DATABASE_PATH=./data/mosaic.db

# Optional Supabase migration credentials are intentionally not required by this version.
# Mosaic uses its own authenticated Node API and SQLite database.
